# Fill in only the providers you use. Providers without keys show
# "Not configured" on the dashboard.

PORT=3000

# --- ClickPesa: Dashboard -> API Integration Setup ---
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=

# --- Snippe: Dashboard -> API keys (snp_live_...) ---
SNIPPE_API_KEY=

# --- AzamPay: Developer portal app credentials ---
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
# Optional, sent as X-API-Key if set
AZAMPAY_API_KEY=
# sandbox (default) or production
AZAMPAY_ENV=sandbox

# --- Selcom: credentials issued by Selcom (info@selcom.net) ---
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_PIN=
# Optional override
SELCOM_BASE_URL=https://apigw.selcommobile.com

# --- Stripe: Developers -> API keys. A restricted key with "Balance: Read" is enough ---
STRIPE_SECRET_KEY=
